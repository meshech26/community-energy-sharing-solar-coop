{
  "info": {
    "name": "Community Energy Sharing API",
    "description": "Postman Collection for testing the Community Energy Sharing & Requests feature.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Seller: Create Listing",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "{{user_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 15,\n  \"unit\": \"kWh\",\n  \"unitPrice\": 45,\n  \"availableDate\": \"2026-10-01T10:00:00.000Z\",\n  \"description\": \"Surplus morning solar\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/energy/listings",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "energy",
            "listings"
          ]
        }
      }
    },
    {
      "name": "2. Admin: View Pending Listings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/energy/admin/pending",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "energy",
            "admin",
            "pending"
          ]
        }
      }
    },
    {
      "name": "3. Admin: Approve Listing",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "{{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/energy/admin/listings/{{listing_id}}/approve",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "energy",
            "admin",
            "listings",
            "{{listing_id}}",
            "approve"
          ]
        }
      }
    },
    {
      "name": "4. Buyer: View Active Listings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/energy/listings",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "energy",
            "listings"
          ]
        }
      }
    },
    {
      "name": "5. Buyer: Create Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "{{admin_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"listingId\": \"{{listing_id}}\",\n  \"quantity\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/energy/orders",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "energy",
            "orders"
          ]
        }
      }
    },
    {
      "name": "6. Buyer: Start Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "{{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/energy/orders/{{order_id}}/payment",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "energy",
            "orders",
            "{{order_id}}",
            "payment"
          ]
        }
      }
    },
    {
      "name": "7. Buyer: Confirm Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "{{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/energy/orders/{{order_id}}/payment/confirm",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "energy",
            "orders",
            "{{order_id}}",
            "payment",
            "confirm"
          ]
        }
      }
    },
    {
      "name": "8. Seller: View My Listings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{user_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/energy/listings/my",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "energy",
            "listings",
            "my"
          ]
        }
      }
    },
    {
      "name": "9. Seller: Edit Listing",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "{{user_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 20,\n  \"unitPrice\": 50\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/energy/listings/{{listing_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "energy",
            "listings",
            "{{listing_id}}"
          ]
        }
      }
    }
  ],
  "event": [
